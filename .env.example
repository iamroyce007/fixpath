# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Check current model names in the official Gemini docs before setting these.
GEMINI_MODEL_RUNTIME=
GEMINI_MODEL_COMPILE=
LLM_TIMEOUT_S=6
# Output rules
GOAL_TRAILING_PERIOD=false
VALIDATION_EXPECTED_VALUES=true
PROVENANCE_MIN_RATIO=80
# Retrieval and cache
DEEPLINK_MIN_SCORE=0.35
CACHE_SIM_THRESHOLD=0.88
# Scoring weights (retrieval, provenance coverage, validator fixes)
SCORE_W_RETRIEVAL=0.5
SCORE_W_PROVENANCE=0.35
SCORE_W_FIXES=0.15
KIT_DIR=kit
